Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Chuyển hướng mọi request không phải tệp/thư mục thực tế vào điểm vào duy nhất vc_public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ vc_public/index.php?url=$1 [QSA,L]
</IfModule>