APP_NAME="VC VPN Commerce"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://vpn.example.com

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vc_vpn_web_commerce
DB_USERNAME=vc_vpn
DB_PASSWORD=secret

JWT_SECRET=your_super_secret_jwt_key_here
VPN_SUB_SECRET=your_subscription_hash_salt_here

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME="VC VPN Commerce"